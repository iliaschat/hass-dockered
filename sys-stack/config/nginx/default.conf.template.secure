# Nginx configuration template for Home Assistant reverse proxy
# This config provides SSL termination, security hardening, and proxying to Home Assistant

# Global directives
access_log /dev/stdout;
error_log /dev/stdout warn;
server_tokens off;

# DNS resolver for dynamic upstream resolution
resolver 127.0.0.11 valid=10s;

# Maps
# Map for WebSocket upgrade handling
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# Map for LAN access
map $remote_addr $lan_access {
  default 0;
  ~^192\.168\. 1;
  ~^10\. 1;
  ~^172\.1[6-9]\. 1;
  ~^172\.2[0-9]\. 1;
  ~^172\.3[0-1]\. 1;
}

# Upstream server definition for Home Assistant
upstream homeassistant {
  zone homeassistant 64k;
  server <HOMEASSISTANT IP>:8123 resolve;
}

# HTTP server block - redirects to HTTPS
server {
  listen 80;
  server_name ${DOMAIN};
  return 301 https://${DOMAIN}$request_uri;
}

# Default HTTP server - blocks all other requests
server {
  listen 80 default_server;
  server_name _;
  location / {
    # Proxy headers
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_redirect off;
    proxy_buffering off;

    # Allow only LAN access
    if ($lan_access = 0) {
      return 444;
    }
    proxy_pass http://homeassistant;
  }
}

# Main HTTPS server block for Home Assistant domain
server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  # SSL Configuration
  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/cert.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_ciphers         HIGH:!aNULL:!MD5;

  # Security headers
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  # Content-Security-Policy: Prevents XSS by restricting resource loading. Allows self, inline scripts/styles for HA, HTTPS/WebSockets for connectivity, blocks objects/frames.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' data: https:; object-src 'none'; frame-ancestors 'self'; base-uri 'none';" always;

  # Security checks
  # Block OPTIONS method as it's not needed for Home Assistant
  if ($request_method = 'OPTIONS') {
    return 444;
  }

  # Block TLS handshakes on HTTP port
  if ($request ~ "^\x16") {
    return 444;
  }

  if ($query_string ~* "(proc/self/environ|/etc/passwd|php://|data://|expect://|../../|proc%2fself%2fenviron|%2fetc%2fpasswd|php%3a%2f%2f|data%3a%2f%2f|expect%3a%2f%2f|%2e%2e%2f%2e%2e%2f|%3Cscript%3E|alert%28|checkwaf)") {
    return 444;
  }

  # Block dangerous patterns in URI and query string (including URL-encoded versions)
  location ~* (proc/self/environ|/etc/passwd|php://|data://|expect://|../../|proc%2fself%2fenviron|%2fetc%2fpasswd|php%3a%2f%2f|data%3a%2f%2f|expect%3a%2f%2f|%2e%2e%2f%2e%2e%2f) {
    return 444;
  }

  # Block executable file extensions
  location ~ \.(php|phtml|pl|py|cgi|sh)$ {
    return 444;
  }

  # Block common vulnerable and sensitive system paths
  location ~* /(cgi-bin|cgi|phpmyadmin|admin|wp-admin|wp-content|wp-includes|xmlrpc\.php|readme\.html|license\.txt|\.git|bin\/sh|\.env|wp-config|libredtail) {
    return 444;
  }

  # Specific WebSocket Endpoint
  location /api/websocket {
    proxy_pass http://homeassistant/api/websocket;

    # Proxy headers
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # WebSocket Support
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  # General Proxy Settings
  location / {
    proxy_pass http://homeassistant;

    # Proxy headers
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # WebSocket Support
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_redirect off;
  }
}

# Default HTTPS server - blocks all other domains/requests
server {
  listen 443 ssl default_server;
  ssl_certificate     /etc/nginx/templates/cert.pem;
  ssl_certificate_key /etc/nginx/templates/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_ciphers         HIGH:!aNULL:!MD5;
  return 444;
}
