# Nginx configuration template for Home Assistant reverse proxy
# This config provides SSL termination, security hardening, and proxying to Home Assistant

access_log /dev/stdout;
error_log /dev/stdout;

# DNS resolver for dynamic upstream resolution
resolver 127.0.0.11 valid=10s;

# Map for WebSocket upgrade handling
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# Upstream server definition for Home Assistant
upstream homeassistant {
  zone homeassistant 64k;
  server <HOMEASSISTANT IP>:8123 resolve;
}

# HTTP server block - redirects to HTTPS
server {
  listen 80;
  server_name ${DOMAIN};
  return 301 https://${DOMAIN}$request_uri;
}

# Default HTTP server - blocks all other requests
server {
  listen 80 default_server;
  server_name _;
  return 444;
}

# Main HTTPS server block for Home Assistant domain
server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  # SSL Configuration
  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/cert.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

  # Security headers
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # Disable buffering for real-time Websocket updates
  proxy_buffering off;

  # Filter query string for dangerous patterns
  if ($query_string ~* "(proc/self/environ|/etc/passwd|php://|data://|expect://|../../)") {
    return 444;
  }

  # Optional: Block specific User-Agent or header patterns if needed
  if ($http_user_agent ~* "php|base64|<script>") {
    return 444;
  }

  # Block URIs with dangerous patterns
  location ~* (proc/self/environ|/etc/passwd|php://|data://|expect://|\.\./\.\.) {
    return 444;
  }

  # Block executable file extensions
  location ~ \.(php|phtml|pl|py|cgi|sh)$ {
    return 444;
  }

  # Block common vulnerable paths
  location ~ ^/(cgi-bin|cgi|phpmyadmin|admin|wp-admin|wp-content|wp-includes|xmlrpc\.php|readme\.html|license\.txt) {
    return 444;
  }

  # Block paths starting with a dot (e.g., .git, .env)
  location ~ ^/\. {
    return 444;
  }

  # Block directory traversal attempts (e.g., ../)
  location ~ \.\./ {
    return 444;
  }

  # Specific WebSocket Endpoint
  location /api/websocket {
    proxy_pass http://homeassistant/api/websocket;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # WebSocket Support
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  # General Proxy Settings
  location / {
    proxy_pass http://homeassistant;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # WebSocket Support
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_redirect off;
  }
}

# Default HTTPS server - blocks all other domains/requests
server {
  listen 443 ssl default_server;
  ssl_certificate     /etc/nginx/templates/cert.pem;
  ssl_certificate_key /etc/nginx/templates/privkey.pem;
  # Recommended modern protocol settings
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers HIGH:!aNULL:!MD5;
  return 444;

