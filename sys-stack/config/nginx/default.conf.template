# Nginx configuration template for Home Assistant reverse proxy
# This config provides SSL termination, security hardening, and proxying to Home Assistant

# access_log is already set in the default nginx.conf included by the Docker image.
# Defining it here again would cause duplicate log entries in docker logs.
# access_log /dev/stdout;
error_log /dev/stdout warn;

# DNS resolver for dynamic upstream resolution
resolver 127.0.0.11 valid=10s;

# Map for WebSocket upgrade handling
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# Upstream server definition for Home Assistant
upstream homeassistant {
  zone homeassistant 64k;
  server <HOMEASSISTANT IP>:8123 resolve;
}

# HTTP catch-all — block every request not addressed to the domain
server {
  listen 80 default_server;
  server_name _;
  return 444;
}

# HTTP domain — serve ACME challenge, then force HTTPS
server {
  listen 80;
  server_name ${DOMAIN};

  # Let's Encrypt HTTP-01 challenge (must come before the redirect)
  location /.well-known/acme-challenge/ {
    root /usr/share/nginx/html;
  }

  location / {
    return 301 https://${DOMAIN}$request_uri;
  }
}

# HTTPS catch-all — reject TLS handshake for unknown domains
server {
  listen 443 ssl default_server;
  server_name _;
  ssl_reject_handshake on;
}

# Main HTTPS server block for Home Assistant domain
server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  # SSL Configuration
  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers HIGH:!aNULL:!MD5;
  ssl_prefer_server_ciphers on;

  # Security headers
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # Disable buffering for real-time Websocket updates
  proxy_buffering off;

  # Specific WebSocket Endpoint
  location /api/websocket {
    proxy_pass http://homeassistant/api/websocket;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # WebSocket Support
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Keep WebSocket connections alive. The default proxy_read_timeout is 60s,
    # which causes nginx to drop idle WebSocket connections and forces the HA app
    # to reconnect repeatedly — each reconnect triggers a new auth attempt and
    # can eventually cause HA to ban the client IP.
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
  }

  # WebSocket: WebRTC signalling (camera streams via /api/webrtc/ws)
  location /api/webrtc/ws {
    proxy_pass http://homeassistant/api/webrtc/ws;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
  }

  # General Proxy Settings
  location / {
    proxy_pass http://homeassistant;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_redirect off;
  }
}